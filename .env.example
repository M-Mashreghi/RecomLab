# Copy to .env for local use. Never commit real secrets.
RECOMLAB_ENV=development
RECOMLAB_DB_URL=sqlite:///./data/recomlab.db
RECOMLAB_LOG_LEVEL=INFO
RECOMLAB_DATASET_ID=tiny
RECOMLAB_EVAL_MODE=full
RECOMLAB_EVAL_K_VALUES=5,10
RECOMLAB_EVAL_SEED=42
# Optional Phase 7 LLM path: none | mock | openai | anthropic
RECOMLAB_LLM_PROVIDER=none
RECOMLAB_LLM_MODEL=
RECOMLAB_LLM_API_KEY=
# Optional: enables POST /models/activate (leave empty to disable API mutations)
RECOMLAB_API_ADMIN_TOKEN=
